{
  "name": "@ssbun/restore-cli",
  "version": "0.1.0",
  "description": "CLI tool to back up important files to iCloud or other destinations",
  "type": "module",
  "bin": {
    "restore": "./dist/index.js"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssbun/restore-cli.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "prepublishOnly": "pnpm build && pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@clack/prompts": "^0.7.0",
    "json5": "^2.2.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vitest": "^1.6.0",
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0"
  }
}
